generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model agent {
  id            Int     @default(autoincrement())
  user_id       Int
  div_id        String  @db.VarChar(4)
  dept_id       String  @db.VarChar(255)
  tahun         String  @db.VarChar(255)
  subholding_id String? @db.VarChar(255)
  corporate_id  String  @db.VarChar(255)

  @@id([user_id, dept_id, tahun, corporate_id])
  @@index([id], map: "id")
  @@index([user_id], map: "user_id")
}

model configuration {
  id                  Int     @id @default(autoincrement())
  meta_title          String? @db.VarChar(100)
  meta_title_en       String? @db.VarChar(100)
  meta_description    String? @db.VarChar(160)
  meta_description_en String? @db.VarChar(160)
  site_description    String? @db.VarChar(255)
  site_description_en String? @db.VarChar(255)
  about               String? @db.VarChar(255)
  about_en            String? @db.VarChar(255)
  working_hour        String? @db.VarChar(50)
  site_title          String? @db.VarChar(100)
  site_title_en       String? @db.VarChar(100)
  address             String  @db.VarChar(200)
  fax                 String? @db.VarChar(50)
  phone               String? @db.VarChar(50)
  email_contact       String? @db.VarChar(100)
  fb_url              String? @db.VarChar(150)
  twitter_url         String? @db.VarChar(150)
  linkedin_url        String? @db.VarChar(150)
}

